From 4053f034117ae73c13a70a1fd31a72b103787e8b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 23 Nov 2026 16:24:26 +0000
Subject: [PATCH 1/4] Bound a switch's range test by its selector's bit width,
 not its storage

A switch on an i1 whose cases 0 and 1 share a block became cmp ult i1 x, 2,
and 2 wraps to 0 in i1, so every value took the default. The width now
comes from integer_bits, which gives 1 for i1.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019erWmHHnB6D36aAa4fKvwn
---
 dev/src/opt/select_formation.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dev/src/opt/select_formation.cpp b/dev/src/opt/select_formation.cpp
index e14ec27e..6ac4370e 100644
--- a/dev/src/opt/select_formation.cpp
+++ b/dev/src/opt/select_formation.cpp
@@ -1167,7 +1167,7 @@ bool SelectFormation::range_switch(BlockId block, InstId id)
 	for (uint32_t k = 1; k < term.extra_count; k += 2)
 		if (!same_target(body_.operands[term.extra_first + k].index, target))
 			return false;
-	const unsigned bits = static_cast<unsigned>(storage_bytes(type) * 8);
+	const unsigned bits = integer_bits(type.kind());
 	const uint64_t mask = bits == 64 ? UINT64_MAX : (uint64_t(1) << bits) - 1;
 	std::vector<uint64_t> values;
 	values.reserve(term.extra_count / 2);
