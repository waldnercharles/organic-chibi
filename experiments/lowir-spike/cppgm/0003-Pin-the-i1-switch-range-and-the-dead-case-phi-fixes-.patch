+
+  block ^next:
+    %j = binary add nowrap i64 %t1, 1
+    jump ^header
+
+  block ^overflow:
+    call void @trap(1)
+    unreachable
+}
+function @e(%x : i64) -> i64 [linkage=c, binding=strong] {
