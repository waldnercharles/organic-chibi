+    %t253 = binary umod u32 %t252, 2
+    %t263 = convert zext i64 u32 %t253
+    %t271 = binary sub i64 1, %t263
+    return i64 %t271
+}
+function @p_e0(%__param0 : ptr, %__param1 : i64, %__param2 : i64, %__param3 : i64, %__param4 : f64) -> i64 [linkage=c, binding=strong] {
+  block ^0:
+    %t3 = convert trunc u8 i64 %__param3
+    %t5 = convert zext i32 u8 %t3
+    switch %t3, ^14, 0:^6, 6:^unrolled_1
+
+  block ^unrolled_1:
+    %t4 = unary bitnot i32 %t5
+    %t6 = unary bitnot i32 %t4
+    jump ^39
+
+  block ^14:
+    %t61 = convert trunc u16 i64 %__param1
+    %t65 = cmp ule u16 %t61, 56
+    switch %t65, ^36, 1:^39
+
+  block ^39:
+    %t9 = phi i32 [^14: %t5, ^unrolled_1: %t6]
+    %t75 = binary and i32 %t9, 127
+    %t76 = convert trunc i8 i32 %t75
+    %t78 = convert sitofp f32 i8 %t76
+    %t79 = call i64 @p_h5(%__param0, %t78)
+    unreachable
+
+  block ^6:
+    call void @chibi_trap(2)
+    unreachable
+
+  block ^36:
+    unreachable
+}
