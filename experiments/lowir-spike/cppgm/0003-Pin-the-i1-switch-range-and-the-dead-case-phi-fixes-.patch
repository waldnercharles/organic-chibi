diff --git a/pa33/tests/regression/o1/700-switch-on-i1-range.t b/pa33/tests/regression/o1/700-switch-on-i1-range.t
new file mode 100644
index 00000000..e6d58b9d
--- /dev/null
+++ b/pa33/tests/regression/o1/700-switch-on-i1-range.t
@@ -0,0 +1,24 @@
+# A switch on an i1 whose cases 0 and 1 share a block takes that block for
+# every value: its range test is bounded by the selector's one bit, not by
+# the byte it is stored in, where the bound 2 wrapped to 0 and every value
+# took the default. @main exits 0.
+function @f(%x : i64) -> i64 [no_inline=yes] {
+  block ^0:
+    %c = cmp lt i64 %x, 2
+    %b = convert trunc i1 i64 %c
+    switch %b, ^2, 0:^1, 1:^1
+
+  block ^1:
+    return i64 0
+
+  block ^2:
+    return i64 1
+}
+
+function @main(%argc : i32, %argv : ptr) -> i32 [role=entry] {
+  block ^0:
+    %x = convert sext i64 i32 %argc
+    %r = call i64 @f(%x)
+    %code = convert trunc i32 i64 %r
+    return i32 %code
+}
