function @f(%x : i64) -> i64 [no_inline=yes] {
  block ^0:
    %c = cmp lt i64 %x, 2
    %b = convert trunc i1 i64 %c
    switch %b, ^2, 0:^1, 1:^1

  block ^1:
    return i64 0

  block ^2:
    return i64 1
}

function @main(%argc : i32, %argv : ptr) -> i32 [role=entry] {
  block ^0:
    %x = convert sext i64 i32 %argc
    %r = call i64 @f(%x)
    %code = convert trunc i32 i64 %r
    return i32 %code
}
