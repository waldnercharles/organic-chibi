  block ^11:
    %t10 = load i64 $1
    %t11 = cmp lt i64 %t10, 6
    branch %t11, ^12, ^13

  block ^12:
    %t12 = load i64 $1
    %t13 = cmp gt i64 %t12, 9223372036854775806
    branch unlikely %t13, ^14, ^15

  block ^15:
    %t14 = binary add nowrap i64 %t12, 1
    store i64 %t14, $1
    jump ^11

  block ^13:
    jump ^16

  block ^16:
    return i64 0

  block ^14:
