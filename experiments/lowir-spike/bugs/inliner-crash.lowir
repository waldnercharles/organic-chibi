    %t6 = cmp ule f64 %t5, -32769
    %t7 = cmp uge f64 %t5, 32768
    %t8 = binary or i64 %t6, %t7
    branch unlikely %t8, ^4, ^10

  block ^10:
    %t9 = convert fptosi i16 f64 %t5
    store i16 %t9, $0
    jump ^9

  block ^9:
    jump ^2

  block ^2:
    store i64 0, $1
