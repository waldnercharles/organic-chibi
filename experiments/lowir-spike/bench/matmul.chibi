extern fn bench_print(x: int)

fn fill(m: []int, seed: int) {
    x := seed
    for i in 0..m.len {
        x = (x *% 1103515245 +% 12345) & 2147483647
        m[i] = x % 100
    }
}

fn multiply(x: []int, y: []int, z: []int, n: int) {
    for i in 0..n {
        for j in 0..n {
            s := 0
            for k in 0..n {
                s += x[i * n + k] * y[k * n + j]
            }
            z[i * n + j] = s
        }
    }
}

export fn main() -> i32 {
    fill(a[0..], 1)
    fill(b[0..], 2)
    sum := 0
    for r in 0..6 {
        multiply(a[0..], b[0..], c[0..], 400)
        sum += c[r * 401]
    }
    bench_print(sum)
    return 0
}
